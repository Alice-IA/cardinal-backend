# ─────────────────────────────────────────────────────────────
# Entorno
# ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# Puerto HTTP del servidor
PORT=3000

# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
# La usa la app y el CLI de Prisma (migrate/generate/studio).
# Si usas el docker-compose incluido, estos valores son los del servicio.
DATABASE_URL="postgresql://alice:alice@localhost:5432/alice_backend?schema=public"

# Base de datos SEPARADA para los tests. Debe terminar en `_test`:
# tests/setup.ts aborta si no es así (los tests truncan tablas).
# El contenedor la crea automáticamente vía docker/init/01-test-db.sql.
TEST_DATABASE_URL="postgresql://alice:alice@localhost:5432/alice_backend_test?schema=public"

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
# Mínimo 32 caracteres cada uno y OBLIGATORIAMENTE distintos entre sí
# (config/env.ts valida ambas cosas al arrancar y mata el proceso si fallan).
# Genera cada uno con:  openssl rand -base64 48
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# ─────────────────────────────────────────────────────────────
# API interna (cardinal-gateway → backend)
# ─────────────────────────────────────────────────────────────
# Secreto compartido para POST /internal/*. Mínimo 32 caracteres.
# Es el ÚNICO secreto del backend que conoce el gateway: no lleva Redis ni el
# WS_TICKET_SECRET. Genera con:  openssl rand -base64 48
INTERNAL_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Redis (reservas NX de tickets WS)
# ─────────────────────────────────────────────────────────────
# Nunca se loguea: puede contener credenciales en la URL.
REDIS_URL="redis://localhost:6379"

# Clave HMAC de los tickets WS. Mínimo 32 caracteres. Solo la conoce el
# backend (el gateway los consume por HTTP). Genera con: openssl rand -base64 48
WS_TICKET_SECRET=""

# ─────────────────────────────────────────────────────────────
# Cifrado del capability token (AES-256-GCM)
# ─────────────────────────────────────────────────────────────
# Base64 de EXACTAMENTE 32 bytes. Genera con:
#   openssl rand -base64 32
# El proceso no arranca si falta o no decodifica a 32 bytes.
TOKEN_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
# Lista separada por comas. Con credentials:true no se permite "*",
# así que los orígenes deben ir explícitos.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
